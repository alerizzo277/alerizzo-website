---
import { site } from '../../data/site';
import { it } from '../../i18n/it';
---
<section class="profile" aria-labelledby="profile-title">
  <div class="profile-heading">
  <figure class="profile-photo">
    <img src="/images/me.jpg" width="2254" height="2254" alt={it.photoAlt} data-i18n-alt="photoAlt" fetchpriority="high" />
    <figcaption>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
      <span data-i18n="location">{it.location}</span>
    </figcaption>
  </figure>
  <div class="profile-copy">
    <h1 id="profile-title">{site.name}</h1>
    <p class="profile-role" data-i18n="role">{site.role}</p>
  </div>
  </div>
  <div class="profile-biography">
    <p data-i18n="introduction">{it.introduction}</p>
    <details class="biography">
      <summary><span class="show-more" data-i18n="showMore">{it.showMore}</span><span class="show-less" data-i18n="showLess">{it.showLess}</span><svg class="disclosure-mark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg></summary>
      {it.biography.map((paragraph, index) => <p data-i18n={`biography.${index}`}>{paragraph}</p>)}
    </details>
  </div>
</section>

<style>
  .profile { padding: var(--space-3); background: var(--color-card); border: 1px solid var(--color-border); border-radius: var(--radius-medium); box-shadow: var(--shadow-card); }
  .profile-heading { display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); }
  .profile-photo { position: relative; margin: 0; justify-self: center; width: 80px; }
  .profile-photo img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 1px solid var(--color-border); }
  figcaption { position: absolute; bottom: -.5rem; left: 50%; transform: translateX(-50%); display: flex; align-items: center; justify-content: center; gap: var(--space-1); width: max-content; max-width: 112px; padding: var(--space-1) var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-pill); background: var(--color-card); color: var(--color-text); box-shadow: 0 2px 6px rgb(0 0 0 / .06); font-size: .6875rem; white-space: nowrap; }
  figcaption svg { flex-shrink: 0; }
  .profile-copy, .profile-biography { min-width: 0; }
  .profile-copy h1 { margin-bottom: var(--space-2); letter-spacing: -.025em; font-size: clamp(1.375rem, 3vw, 2.125rem); }
  .profile-role { font-size: 1rem; font-weight: 500; color: var(--color-text); margin-bottom: 0; }
  .profile-biography > p, .biography p { max-width: none; width: 100%; line-height: 1.8; }
  .biography { position: relative; margin-top: var(--space-2); }
  .biography[open] { margin-top: var(--space-3); padding-bottom: calc(var(--control-height) + var(--space-2)); }
  .biography[open] summary { position: absolute; bottom: 0; inset-inline-start: 0; }
  summary { display: flex; align-items: center; gap: var(--space-2); width: fit-content; min-height: 44px; padding: var(--space-2) 0; border: 0; background: transparent; color: var(--color-text); cursor: pointer; font-weight: 600; font-size: .875rem; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { text-decoration: underline; text-underline-offset: .25em; }
  .show-less, details[open] .show-more { display: none; }
  details[open] .show-less { display: inline; }
  summary:focus:not(:focus-visible) { outline: none; }
  summary:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: var(--radius-small); }
  .disclosure-mark { flex-shrink: 0; }
  details[open] .disclosure-mark { transform: rotate(180deg); }
  .biography p { margin: 0; }
  .biography p + p { margin-top: var(--space-3); }
  @media (min-width: 48rem) {
    .profile { display: grid; grid-template-columns: 128px minmax(0, 1fr); column-gap: var(--space-4); row-gap: var(--space-3); align-items: start; padding: var(--space-4); }
    .profile-heading { display: contents; }
    .profile-photo { grid-column: 1; grid-row: 1 / span 2; align-self: start; width: 116px; }
    .profile-copy, .profile-biography { grid-column: 2; }
    .profile-role { font-size: 1.125rem; }
    figcaption { max-width: 128px; font-size: .75rem; }
  }
</style>
