---
import type { TimelineEntry } from '../../data/timeline';
import { it } from '../../i18n/it';
import Period from './Period.astro';
import ExperienceDuration from './ExperienceDuration.astro';
import DetailDialog from './DetailDialog.astro';
interface Props { entry: TimelineEntry; showDuration?: boolean }
const { entry, showDuration = false } = Astro.props;
---
<li class="timeline-item">
  <button class="timeline-card" type="button" data-dialog={`detail-${entry.id}`} aria-haspopup="dialog" aria-controls={`detail-${entry.id}`}>
    <img src={entry.logo} width="48" height="48" alt="" loading="lazy" />
    <span class="card-copy">
      <span class="card-heading"><span class="card-name">{entry.name}</span>{!entry.end && <span class="current" data-i18n="timeline.current">{it.timeline.current}</span>}</span>
      <span class="card-role" data-i18n={`entries.${entry.id}.role`}>{entry.role}</span>
      <span class="card-period"><Period start={entry.start} end={entry.end} />{showDuration && <ExperienceDuration start={entry.start} end={entry.end} />}</span>
    </span>
    <svg class="card-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
  </button>
  <DetailDialog entry={entry} showDuration={showDuration} />
</li>
<style>
  .timeline-item { position: relative; padding: 0 0 var(--space-3) var(--space-4); }
  .timeline-item::after { content: ''; position: absolute; top: 0; bottom: 0; left: var(--timeline-axis); width: 2px; transform: translateX(-50%); background: var(--color-timeline-line); }
  .timeline-item::before { content: ''; position: absolute; top: var(--timeline-node-y); left: var(--timeline-axis); width: var(--timeline-node-size); height: var(--timeline-node-size); transform: translate(-50%, -50%); border-radius: 50%; background: var(--color-timeline-line); z-index: 1; }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-card { display: flex; align-items: flex-start; gap: var(--space-3); width: 100%; padding: .75rem var(--space-3); text-align: left; font: inherit; color: var(--color-text); background: var(--color-card); border: 1px solid var(--color-border); border-radius: var(--radius-medium); box-shadow: var(--shadow-card); cursor: pointer; }
  .timeline-card:hover { background: var(--color-surface); border-color: var(--color-text-muted); }
  .timeline-card img { width: 40px; height: 40px; object-fit: contain; flex-shrink: 0; }
  .card-copy { min-width: 0; flex: 1; }
  .card-heading { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
  .card-name { font-weight: 600; line-height: 1.4; }
  .current { font-size: .6875rem; background: var(--color-surface); color: var(--color-text-description); padding: .1rem .4rem; border-radius: var(--radius-small); }
  .card-role, .card-period { display: block; }
  .card-role { color: var(--color-text-description); margin-top: var(--space-1); font-size: .9375rem; }
  .card-period { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); margin-top: var(--space-1); color: var(--color-text-muted); font-size: .8125rem; }
  .card-chevron { align-self: center; flex-shrink: 0; color: var(--color-text-muted); }
</style>
